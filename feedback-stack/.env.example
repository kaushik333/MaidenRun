# Consumed by `docker compose up` in this directory (compose reads .env from
# its own project directory automatically). In production these are exported
# by the EC2 boot script instead — see backend/app/aws/feedback_stack.py in
# the control plane.
POSTGRES_PASSWORD=local-dev-password
DEPLOYMENT_ID=local
# Visit the dashboard locally at http://localhost:8003/?token=local-dev-token
DASHBOARD_TOKEN=local-dev-token
