# For running `uvicorn app.main:app` directly against source, outside Docker.
DATABASE_URL=postgresql://postgres:local-dev-password@localhost:5432/feedback
DEPLOYMENT_ID=local
FEEDBACK_QUESTIONS_PATH=/opt/feedback-stack/feedback-questions.json
FEEDBACK_FORM_PORT=8000
LOG_LEVEL=INFO

# SERVICE_ROLE=form serves the questionnaire at `/`; SERVICE_ROLE=dashboard
# serves the token-gated dashboard instead — see app/main.py. Run two
# separate `uvicorn` processes (different .env / env vars) to exercise both
# locally, matching feedback-stack/docker-compose.yml's two containers.
SERVICE_ROLE=form
DASHBOARD_TOKEN=local-dev-token
