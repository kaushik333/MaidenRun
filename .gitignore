.env
# root logs/ and data/ ship as empty dirs (.gitkeep) so Docker never
# creates them root-owned; any other logs/ or data/ stays fully ignored
**/logs/*
**/data/*
!/logs/.gitkeep
!/data/.gitkeep
**/__pycache__/
*.pyc
**/.pytest_cache/

# python
**/.venv/

# node
**/node_modules/
**/dist/

# local copy of feedback-stack/feedback-questions.example.json for standalone dev
feedback-stack/feedback-questions.json
