# --- server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173

# Empty disables auth entirely (the default — fine for a backend only
# reachable from your own machine). Set this before exposing the backend
# to any other network — e.g. a cluster with network access — and paste
# the same value into the frontend's "API secret" field once per browser.
# Generate with: openssl rand -hex 32
CONTROL_PLANE_SECRET=

# --- logging (control plane's own run logs: logs/<user-id>/<run-id>/...) ---
LOG_DIR=logs
USER_ID=local
LOG_LEVEL=INFO

# --- aws (used from Phase 4 onward) ---
AWS_DEFAULT_REGION=us-east-1
# Local cache for the AWS access key pasted into the deploy form. Defaults to
# ~/.agentdock/credentials.json when run directly, and to data/credentials.json
# under docker compose — leave commented out unless you need to override it
# (an uncommented blank value would override the default with an empty path,
# so don't just uncomment this as-is).
# AWS_CREDENTIALS_PATH=/custom/path/credentials.json

# --- docker compose: host user the backend container runs as ---
# Only needed if `id -u` / `id -g` aren't 1000, so files in logs/ and data/
# stay owned by you.
# UID=1000
# GID=1000

# --- reserved ports (fixed contract, do not change) ---
APP_PORT=8001
FEEDBACK_FORM_PORT=8002
FEEDBACK_DASHBOARD_PORT=8003

# How long the background deployment task waits for the agent to answer on
# :8001 before giving up (EC2 boot + Docker install + image build/pull can
# be slow).
APP_HEALTH_TIMEOUT_SECONDS=300
