{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:*:*:parameter/maidenrun/*"
    },
    {
      "Sid": "DecryptOwnSecrets",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:*:*:key/alias/aws/ssm"
    },
    {
      "Sid": "ReadOwnFeedbackBundle",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::maidenrun-*/feedback-stack-bundles/*"
    }
  ]
}
